\\ Vollstaendiger primaerer PARI-Audit des deterministischen Kandidaten c=44730.
default(timer, 1);
default(realprecision, 100);
default(parisize, 536870912);
default(parisizemax, 4294967296);
default(factor_proven, 1);

p = 2^301 - 2^99 + 947;
d = 301;
c = 44730;
s = 947 + c;
a = lift(Mod(s, p)^2);
if (s != 45677 || a != 2086388329, error("Kandidatenableitung stimmt nicht"));
if (kronecker(a, p) != 1 || kronecker(d, p) != -1, error("Legendre-Bedingungen verletzt"));
if (a == 0 || d == 0 || a == d, error("singulaerer Edwards-Parameter"));

A = lift(Mod(2 * (a + d), p) / Mod(a - d, p));
B = lift(Mod(4, p) / Mod(a - d, p));
A24_plus = lift(Mod(A + 2, p) / Mod(4, p));
A24_minus = lift(Mod(A - 2, p) / Mod(4, p));
if (A == 2 || A == p-2 || B == 0, error("ungueltige Montgomery-Parameter"));
if (kronecker(A^2 - 4, p) != -1, error("A^2-4 ist nicht der erwartete Nichtrest"));

a2 = lift(Mod(A * B, p));
a4 = lift(Mod(B^2, p));
E = ellinit([0, Mod(a2, p), 0, Mod(a4, p), 0]);
z = 2;
if (kronecker(z, p) != -1, error("z=2 ist kein Nichtrest"));
Et = ellinit([0, Mod(z*a2, p), 0, Mod(z^2*a4, p), 0]);

N_expected = 4074071952668972172536891376818756322102936789371269161834491587034136893877719336157337612;
q_expected = 1018517988167243043134222844204689080525734197342817290458622896758534223469429834039334403;
Nt_expected = 4074071952668972172536891376818756322102936785292475840710068942732788076946225991873048412;
qt_expected = 1018517988167243043134222844204689080525734196323118960177517235683197019236556497968262103;

t0 = getwalltime();
N = ellsea(E);
t1 = getwalltime();
Nt = ellsea(Et);
t2 = getwalltime();
N_ellcard = ellcard(E);
t3 = getwalltime();
Nt_ellcard = ellcard(Et);
t4 = getwalltime();

if (N != N_expected || Nt != Nt_expected, error("direktes SEA weicht vom Suchresultat ab"));
if (N_ellcard != N || Nt_ellcard != Nt, error("ellcard weicht von ellsea ab"));
if (N + Nt != 2*p + 2, error("Twistrelation verletzt"));

fN = factor(N);
fNt = factor(Nt);
q = N / 4;
qt = Nt / 4;
if (q != q_expected || qt != qt_expected, error("Untergruppenordnung weicht ab"));
if (fN != [2,2; q,1] || fNt != [2,2; qt,1], error("Ordnung ist nicht exakt 4*Primzahl"));
if (!isprime(q) || !isprime(qt), error("Untergruppenfaktor nicht formal prim"));

cert_q = primecert(q, 0);
cert_qt = primecert(qt, 0);
if (!primecertisvalid(cert_q) || !primecertisvalid(cert_qt), error("ECPP-Zertifikat ungueltig"));

fd = fileopen("ed301_technischer_abschluss/zertifikate/c44730_q_ecpp_internal.pari", "w");
filewrite(fd, cert_q);
fileclose(fd);
fd = fileopen("ed301_technischer_abschluss/zertifikate/c44730_q_ecpp_human.txt", "w");
filewrite(fd, primecertexport(cert_q, 0));
fileclose(fd);
fd = fileopen("ed301_technischer_abschluss/zertifikate/c44730_q_ecpp_primo.txt", "w");
filewrite(fd, primecertexport(cert_q, 1));
fileclose(fd);
fd = fileopen("ed301_technischer_abschluss/zertifikate/c44730_q_ecpp_magma.m", "w");
filewrite(fd, primecertexport(cert_q, 2));
fileclose(fd);

fd = fileopen("ed301_technischer_abschluss/zertifikate/c44730_q_twist_ecpp_internal.pari", "w");
filewrite(fd, cert_qt);
fileclose(fd);
fd = fileopen("ed301_technischer_abschluss/zertifikate/c44730_q_twist_ecpp_human.txt", "w");
filewrite(fd, primecertexport(cert_qt, 0));
fileclose(fd);
fd = fileopen("ed301_technischer_abschluss/zertifikate/c44730_q_twist_ecpp_primo.txt", "w");
filewrite(fd, primecertexport(cert_qt, 1));
fileclose(fd);
fd = fileopen("ed301_technischer_abschluss/zertifikate/c44730_q_twist_ecpp_magma.m", "w");
filewrite(fd, primecertexport(cert_qt, 2));
fileclose(fd);

t = p + 1 - N;
tt = p + 1 - Nt;
if (tt != -t || t^2 > 4*p, error("Trace-/Hasse-Pruefung fehlgeschlagen"));
Delta_pi = t^2 - 4*p;
D_K = coredisc(Delta_pi);
if (!issquare(Delta_pi / D_K, &f_pi), error("Frobeniusdiskriminante zerlegt nicht"));
j = lift(E.j);
if (j != lift(Et.j), error("Twist-j weicht ab"));

x_order4 = lift(Mod(1, p) / Mod(s, p));
if (lift(Mod(a*x_order4^2, p)) != 1, error("Edwards-Ordnungs-4-Punkt fehlt"));

print("pari_version=", version());
print("c=", c);
print("s=", s);
print("a=", a);
print("d=", d);
print("A=", A);
print("B=", B);
print("A24_plus=", A24_plus);
print("A24_minus=", A24_minus);
print("weierstrass_coefficients=", [0,a2,0,a4,0]);
print("twist_z=", z);
print("twist_coefficients=", [0,lift(Mod(z*a2,p)),0,lift(Mod(z^2*a4,p)),0]);
print("N=", N);
print("factor_N=", fN);
print("q=", q);
print("bitlen_q=", logint(q,2)+1);
print("log2_q=", log(q)/log(2));
print("N_twist=", Nt);
print("factor_N_twist=", fNt);
print("q_twist=", qt);
print("bitlen_q_twist=", logint(qt,2)+1);
print("log2_q_twist=", log(qt)/log(2));
print("ellsea_curve_ms=", t1-t0);
print("ellsea_twist_ms=", t2-t1);
print("ellcard_curve_ms=", t3-t2);
print("ellcard_twist_ms=", t4-t3);
print("trace=", t);
print("trace_twist=", tt);
print("hasse_pass=", t^2 <= 4*p);
print("j=", j);
print("j_is_zero=", j==0);
print("j_is_1728=", j==lift(Mod(1728,p)));
print("supersingular_curve=", ellissupersingular(E));
print("supersingular_twist=", ellissupersingular(Et));
print("frobenius_discriminant=", Delta_pi);
print("fundamental_discriminant=", D_K);
print("frobenius_conductor=", f_pi);
print("factor_frobenius_conductor=", factor(f_pi));
print("x_order4=", x_order4);
print("q_primecertisvalid=1");
print("q_twist_primecertisvalid=1");

fd = fileopen("ed301_technischer_abschluss/rohresultate/audit_candidate_c44730_pari.txt", "w");
filewrite(fd, Str("pari_version=", version()));
filewrite(fd, Str("c=",c));
filewrite(fd, Str("s=",s));
filewrite(fd, Str("a=",a));
filewrite(fd, Str("d=",d));
filewrite(fd, Str("A=",A));
filewrite(fd, Str("B=",B));
filewrite(fd, Str("A24_plus=",A24_plus));
filewrite(fd, Str("A24_minus=",A24_minus));
filewrite(fd, Str("weierstrass_coefficients=",[0,a2,0,a4,0]));
filewrite(fd, Str("twist_z=",z));
filewrite(fd, Str("twist_coefficients=",[0,lift(Mod(z*a2,p)),0,lift(Mod(z^2*a4,p)),0]));
filewrite(fd, Str("N=",N));
filewrite(fd, Str("factor_N=",fN));
filewrite(fd, Str("q=",q));
filewrite(fd, Str("bitlen_q=",logint(q,2)+1));
filewrite(fd, Str("log2_q=",log(q)/log(2)));
filewrite(fd, Str("N_twist=",Nt));
filewrite(fd, Str("factor_N_twist=",fNt));
filewrite(fd, Str("q_twist=",qt));
filewrite(fd, Str("bitlen_q_twist=",logint(qt,2)+1));
filewrite(fd, Str("log2_q_twist=",log(qt)/log(2)));
filewrite(fd, Str("ellsea_curve_ms=",t1-t0));
filewrite(fd, Str("ellsea_twist_ms=",t2-t1));
filewrite(fd, Str("ellcard_curve_ms=",t3-t2));
filewrite(fd, Str("ellcard_twist_ms=",t4-t3));
filewrite(fd, Str("trace=",t));
filewrite(fd, Str("trace_twist=",tt));
filewrite(fd, Str("hasse_pass=",t^2<=4*p));
filewrite(fd, Str("j=",j));
filewrite(fd, Str("j_is_zero=",j==0));
filewrite(fd, Str("j_is_1728=",j==lift(Mod(1728,p))));
filewrite(fd, Str("supersingular_curve=",ellissupersingular(E)));
filewrite(fd, Str("supersingular_twist=",ellissupersingular(Et)));
filewrite(fd, Str("frobenius_discriminant=",Delta_pi));
filewrite(fd, Str("fundamental_discriminant=",D_K));
filewrite(fd, Str("frobenius_conductor=",f_pi));
filewrite(fd, Str("factor_frobenius_conductor=",factor(f_pi)));
filewrite(fd, Str("x_order4=",x_order4));
filewrite(fd, "q_primecertisvalid=1");
filewrite(fd, "q_twist_primecertisvalid=1");
fileclose(fd);
quit;
