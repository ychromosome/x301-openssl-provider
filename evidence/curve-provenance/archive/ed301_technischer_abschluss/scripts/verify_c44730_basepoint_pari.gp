default(parisize, 536870912);
default(factor_proven, 1);
p = 2^301 - 2^99 + 947;
a = 2086388329;
d = 301;
q = 1018517988167243043134222844204689080525734197342817290458622896758534223469429834039334403;
N = 4*q;
gx = 114483960210649758260691970228447544333115946824833551736797985468026643833345600929055;
gy = 3123599847077067352547410063473606051762622289826321814465731066121453938271612909425522539;
u_expected = 1067917942141295978366266158278333061632895636270240461974100298644709548352069314007836251;
v_expected = 440719678915870457116701635146449947572460444481575851594677144469352806862244984556749020;
A = lift(Mod(2*(a+d),p)/Mod(a-d,p));
B = lift(Mod(4,p)/Mod(a-d,p));
u = lift(Mod(1+gy,p)/Mod(1-gy,p));
v = lift(Mod(u,p)/Mod(gx,p));
if (u != u_expected || v != v_expected, error("Montgomery map mismatch"));
if (lift(Mod(B*v^2-(u^3+A*u^2+u),p)) != 0, error("Montgomery equation failed"));
X = lift(Mod(B*u,p));
Y = lift(Mod(B^2*v,p));
E = ellinit([0,Mod(A*B,p),0,Mod(B^2,p),0]);
Q = [Mod(X,p),Mod(Y,p)];
if (!ellisoncurve(E,Q), error("Weierstrass point off curve"));
qQ = ellmul(E,Q,q);
if (qQ != [0], error("qQ is not infinity"));
ordQ = ellorder(E,Q,[N,factor(N)]);
if (ordQ != q, error("point order mismatch"));
print("pari_version=",version());
print("A=",A);
print("B=",B);
print("u=",u);
print("v=",v);
print("weierstrass_X=",X);
print("weierstrass_Y=",Y);
print("ellisoncurve=1");
print("q_times_Q=",qQ);
print("ellorder_Q=",ordQ);
print("pari_basepoint_crosscheck_pass=1");
quit;
